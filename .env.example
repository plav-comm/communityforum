####################################################################
# COMMUNITY-SPAN — environment variables
#
# Copy this file to a file named exactly ".env" and fill in the values.
# Never commit .env to git. On Render/Railway you paste these into the
# dashboard's Environment tab instead of using a file.
#
# Only the four marked REQUIRED are needed to boot. The rest have
# sensible defaults.
####################################################################


# ─── 1. DATABASE ──────────────────────────────────────────── REQUIRED
# Where to get this (Supabase, free tier):
#   supabase.com -> New project -> wait ~2 min for it to provision
#   -> Project Settings -> Database -> Connection string -> URI
#   -> copy it and replace [YOUR-PASSWORD] with the database password
#      you chose when creating the project.
#
# Use the CONNECTION POOLER string (port 6543) if you see one — it
# handles many short-lived connections better than the direct 5432 port.
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Supabase, Neon, Render and Railway all require TLS. Leave this unset and
# it is detected automatically from the host name. Set to false only for a
# local Postgres running on your own machine.
# DATABASE_SSL=true

# Connection pool size. 8 is a good default. Free-tier Postgres plans
# sometimes cap total connections — if you see "too many clients", lower it.
# DB_POOL_MAX=8


# ─── 2. YOUTUBE DATA API ──────────────────────────────────── REQUIRED
# Where to get this (free):
#   1. console.cloud.google.com -> create a project called "Community-Span"
#   2. APIs & Services -> Library -> search "YouTube Data API v3" -> Enable
#   3. APIs & Services -> Credentials -> Create credentials -> API key
#   4. Click the key -> Restrict key -> API restrictions -> YouTube Data API v3
#      (Leave "Application restrictions" as None. This key is used from your
#       server, not a browser, so there is no referrer to restrict to.)
#
# The free allowance is 10,000 units/day. This app is engineered to stay
# well inside it: roughly 250-400 units/day for 200 monitored channels.
YOUTUBE_API_KEY=AIzaSy...


# ─── 3. WEBSUB (real-time push from YouTube) ──────────────── REQUIRED
# The public HTTPS address of THIS server. YouTube's hub calls it whenever a
# monitored channel uploads or goes live, so it must be reachable from the
# open internet — not localhost.
#   On Render this is https://your-service-name.onrender.com
#   With your own domain, https://api.community-span.com
# No trailing slash.
PUBLIC_BASE_URL=https://community-span-api.onrender.com

# A long random string used to sign push notifications, so you can prove a
# notification really came from YouTube's hub and not from a stranger who
# guessed your callback URL. Generate one with:
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBSUB_SECRET=replace-me-with-64-random-hex-characters

# A second random string, echoed during the subscription handshake. Same
# generator as above. Different value.
WEBSUB_VERIFY_TOKEN=replace-me-with-another-random-string

# Where the callback lives. Change only if you want a different path.
# WEBSUB_CALLBACK_PATH=/websub/youtube
# Google's hub. Do not change.
# WEBSUB_HUB_URL=https://pubsubhubbub.appspot.com/subscribe
# Lease length in seconds. 828000 (~9.6 days) is Google's maximum.
# WEBSUB_LEASE_SECONDS=828000
# Renew when fewer than this many hours remain on the lease.
# WEBSUB_RENEW_WINDOW_HOURS=48


# ─── 4. ADMIN ACCESS ──────────────────────────────────────── REQUIRED
# Protects /admin/* (adding channels, forcing a re-tag, running the daily job
# by hand). Another long random string. You send it as a Bearer token.
ADMIN_TOKEN=replace-me-with-a-long-random-string


# ─── 5. RUNTIME ───────────────────────────────────────────── optional
# The port the server listens on. Render sets this for you automatically.
# PORT=3000
# production | development
# NODE_ENV=production
# error | warn | info | debug
# LOG_LEVEL=info
# Browser origins allowed to call the API. Use * while prototyping; once the
# site has its own domain, list it: https://community-span.com
# CORS_ORIGINS=*


# ─── 6. TOPIC TAGGING ─────────────────────────────────────── optional
# Minimum score before a topic is attached to a meeting. Raise it for fewer,
# more confident tags; lower it for broader coverage.
# TOPIC_SCORE_THRESHOLD=2.0
# Never attach more than this many topics to one meeting.
# MAX_TOPICS_PER_VIDEO=4
# How many recent uploads per channel the daily safety net re-checks.
# BACKFILL_PER_CHANNEL=10
# If a push arrives from a channel that is not in your channels table, add it
# automatically? Off by default — only a human knows which town it serves.
# AUTO_ADD_CHANNELS=false
# Only import videos whose title looks like a public meeting (council,
# commission, board, hearing, session, budget...). Keeps concerts, PSAs and
# Shorts from community-access channels off the site. Default true.
# MEETINGS_ONLY=true


# ─── 7. TRANSCRIPTS ───────────────────────────────────────── optional
# Leave unset. YouTube's API cannot legally give you transcripts for channels
# you do not own, so launch tagging reads titles, descriptions and tags.
# See server/lib/transcript.js when you are ready to add a provider.
# TRANSCRIPT_PROVIDER=none
